+
+static inline guint32
+fpc_u32 (FpiDeviceFpcMoh *self, guint32 val)
+{
+  return self->is_le ? GUINT32_FROM_LE (val) : GUINT32_FROM_BE (val);
+}
+
+static inline guint16
+fpc_u16 (FpiDeviceFpcMoh *self, guint16 val)
+{
+  return self->is_le ? GUINT16_FROM_LE (val) : GUINT16_FROM_BE (val);
+}
