+#define EP_IN (self->ep_in ? self->ep_in : (2 | FPI_USB_ENDPOINT_IN))
 #define EP_IN_MAX_BUF_SIZE (2048)
 
 
@@ -356,4 +356,5 @@ struct _FpiDeviceFpcMoh
 
   /* patches/0010: samples the matcher refused during this enrollment. */
   guint32         enroll_rejects;
